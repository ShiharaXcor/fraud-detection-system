models/mlruns/

# ── Data files (too large for GitHub) ─────────────────────────────
data/raw/
data/processed/*.parquet
data/processed/*.csv

# Keep the PNG charts — they are small and useful to show
!data/processed/*.png

# ── Trained models (too large) ────────────────────────────────────
models/*.pkl
models/*.json
models/*.npy

# Keep metrics.json — small and useful
!models/metrics.json
!models/shap_importance.json
!models/top_features.json

